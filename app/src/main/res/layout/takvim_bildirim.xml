<?xml version="1.0" encoding="utf-8"?>
<!--
    Bildirim çubuğundaki ay takvimi: yalnızca gün ızgarası.

    Ay adı burada yazmıyor çünkü sistem zaten bildirimin kendi başlığında
    yazıyor; iki kez yazmak boş yere yer kaplıyordu. Gün adları satırı da
    kalktı — sütunların sırası zaten hep aynı.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/takvim_geri"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="‹"
            android:textSize="20sp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/takvim_bugun_dugme"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Bugün"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <TextView
            android:id="@+id/takvim_ileri"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="›"
            android:textSize="20sp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/takvim_gunler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
