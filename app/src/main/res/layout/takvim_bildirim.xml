<?xml version="1.0" encoding="utf-8"?>
<!--
    Bildirim çubuğundaki ay takvimi: önce gün ızgarası, en altta oklar.

    Oklar üstteyken uygulama adıyla ilk gün satırı arasında bir satırlık
    boşluk kalıyordu; alta alınca ızgara doğrudan başlığın altından
    başlıyor. Kök düzende hiç dolgu yok — kalan boşluk sistemin kendi
    bildirim kenarlığı, ona dokunamıyoruz.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/takvim_gunler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/takvim_geri"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="‹"
            android:textSize="18sp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/takvim_bugun_dugme"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Bugün"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <TextView
            android:id="@+id/takvim_ileri"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="›"
            android:textSize="18sp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>
</LinearLayout>
