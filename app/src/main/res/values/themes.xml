<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Merkez" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--
        Launcher (ana ekran) teması: pencere arkasında sistem duvar kâğıdı görünür,
        durum/gezinme çubukları saydam. İçerik doğrudan duvar kâğıdının üzerine çizilir.
    -->
    <style name="Theme.Merkez.Launcher" parent="Theme.Merkez">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
