<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Merkez" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--
        Launcher (ana ekran) teması: pencere arkasında sistem duvar kâğıdı görünür,
        durum/gezinme çubukları saydam. İçerik doğrudan duvar kâğıdının üzerine çizilir.
    -->
    <style name="Theme.Merkez.Launcher" parent="Theme.Merkez">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        Başka uygulamalarda seçilen metin için açılan kutu: kayan pencere,
        arkası karartılıyor. Uygulamaya geçilmiş hissi vermesin.
    -->
    <style name="Theme.Merkez.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
