<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Merkez" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>


    <!--
        Başka uygulamalarda seçilen metin için açılan kutu: kayan pencere,
        arkası karartılıyor. Uygulamaya geçilmiş hissi vermesin.
    -->
    <style name="Theme.Merkez.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
