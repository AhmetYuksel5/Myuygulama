<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sesli yazma: klavyenin üstündeki mikrofon. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Son uygulamalar panelinde yana fırlatılan uygulamanın arka plan işlemini kapatmak. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Zamanlanmış ajan görevi çalışırken ekran kararmasın. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Kapanan erişilebilirlik servisini geri açmak. Uygulama kendine
         veremiyor; bilgisayardan bir kez verilirse kullanılıyor. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>

        <service
            android:name=".QuickCursorService"
            android:exported="true"
            android:label="@string/quick_cursor_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/quick_cursor_config" />
        </service>

        <service
            android:name=".VoiceRecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Seçilen bildirimleri gizleyen süzgeç. -->
        <service
            android:name=".NotificationFilterService"
            android:exported="true"
            android:label="Merkez bildirim süzgeci"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Ekran ajanı zamanlayıcısı: saat gelince, telefon açılınca ve güncellemeden sonra. -->
        <receiver
            android:name=".AgentAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".AgentRearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".AgentWakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:turnScreenOn="true" />
    </application>

</manifest>
